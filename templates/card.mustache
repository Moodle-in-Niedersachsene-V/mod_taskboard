{{!
    @template mod_taskboard/card

    One card on the board. The whole card is a button: click opens it, pointer or keyboard moves it.

    Example context (json):
    {
        "id": 12, "columnid": 2, "title": "Interview the climate officer", "arialabel": "Interview the climate officer.",
        "labels": [{"key": "research", "name": "Research"}], "haslabels": true,
        "hasduedate": true, "duedate": "20 Nov", "overdue": false,
        "haschecks": true, "checksdone": 1, "checkstotal": 4,
        "hasimage": false, "imageurl": "", "hasvideo": false, "haslinks": true, "linkcount": 2, "isdone": false, "pending": false,
        "assignees": [{"userid": 5, "fullname": "Lea Sommer", "initials": "LS", "colour": 6}],
        "hasmoreassignees": false, "moreassignees": 0, "canmove": true, "canedit": true
    }
}}
<button type="button" class="mod_taskboard-card{{#pending}} mod_taskboard-pending{{/pending}}{{#hasimage}} mod_taskboard-hasimage{{/hasimage}}"
    data-region="mod_taskboard-card" data-cardid="{{id}}" data-canmove="{{#canmove}}1{{/canmove}}{{^canmove}}0{{/canmove}}"
    aria-label="{{arialabel}}" aria-pressed="false">
    {{#hasimage}}
    <img class="mod_taskboard-cover" src="{{imageurl}}" alt="" draggable="false" loading="lazy">
    {{/hasimage}}
    <span class="mod_taskboard-cardbody">
        {{#haslabels}}
        <span class="mod_taskboard-labels">
            {{#labels}}<span class="mod_taskboard-label mod_taskboard-label-{{key}}">{{name}}</span>{{/labels}}
        </span>
        {{/haslabels}}
        <span class="mod_taskboard-title">{{title}}</span>
        <span class="mod_taskboard-meta">
            {{#pending}}<span class="mod_taskboard-badge-pending">{{#str}}pendingapproval, mod_taskboard{{/str}}</span>{{/pending}}
            {{#isdone}}
            <span class="mod_taskboard-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"></polyline></svg>{{#str}}donebadge, mod_taskboard{{/str}}</span>
            {{/isdone}}
            {{#hasduedate}}
            <span class="mod_taskboard-due{{#overdue}} mod_taskboard-overdue{{/overdue}}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>{{duedate}}</span>
            {{/hasduedate}}
            {{#haschecks}}
            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="3"></rect><polyline points="8 12 11 15 16 9"></polyline></svg>{{checksdone}}/{{checkstotal}}</span>
            {{/haschecks}}
            {{#hasimage}}
            <span class="mod_taskboard-imagehint"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg></span>
            {{/hasimage}}
            {{#haslinks}}
            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>{{linkcount}}</span>
            {{/haslinks}}
            {{#hasvideo}}
            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg></span>
            {{/hasvideo}}
            <span class="mod_taskboard-spacer"></span>
            <span class="mod_taskboard-avatars">
                {{#assignees}}<span class="mod_taskboard-avatar mod_taskboard-avatar-{{colour}}" title="{{fullname}}">{{initials}}</span>{{/assignees}}
                {{#hasmoreassignees}}<span class="mod_taskboard-avatar mod_taskboard-avatar-more">+{{moreassignees}}</span>{{/hasmoreassignees}}
            </span>
        </span>
    </span>
</button>
