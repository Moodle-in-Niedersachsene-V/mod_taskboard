{{!
    @template mod_taskboard/column

    One column with its cards.

    Example context (json):
    {
        "id": 2, "title": "In progress", "wiplimit": 3, "haswiplimit": true, "isdone": false, "count": 4,
        "overlimit": true, "countlabel": "4 / 3", "canmanage": true, "canmoveleft": true,
        "canmoveright": true, "canadd": true, "cards": []
    }
}}
<section class="mod_taskboard-column{{#overlimit}} mod_taskboard-overlimit{{/overlimit}}" data-region="mod_taskboard-column"
    data-columnid="{{id}}" data-wiplimit="{{wiplimit}}" aria-labelledby="mod_taskboard-coltitle-{{id}}">
    <div class="mod_taskboard-columnhead d-flex align-items-center justify-content-between gap-2">
        <h4 id="mod_taskboard-coltitle-{{id}}" class="h6 mb-0 text-break">{{title}}</h4>
        <div class="d-flex align-items-center gap-1">
            <span class="badge rounded-pill mod_taskboard-count" data-region="mod_taskboard-count">{{countlabel}}</span>
            {{#canmanage}}
            <div class="dropdown">
                <button type="button" class="btn btn-icon btn-sm mod_taskboard-colmenu" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                    title="{{#str}}columnactions, mod_taskboard, {{title}}{{/str}}">
                    {{#pix}}i/menu, core, {{#str}}columnactions, mod_taskboard, {{title}}{{/str}}{{/pix}}
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    <button type="button" class="dropdown-item" data-action="editcolumn" data-columnid="{{id}}">{{#str}}editcolumn, mod_taskboard{{/str}}</button>
                    {{#canmoveleft}}
                    <button type="button" class="dropdown-item" data-action="movecolumn" data-direction="-1" data-columnid="{{id}}">{{#str}}movecolumnleft, mod_taskboard{{/str}}</button>
                    {{/canmoveleft}}
                    {{#canmoveright}}
                    <button type="button" class="dropdown-item" data-action="movecolumn" data-direction="1" data-columnid="{{id}}">{{#str}}movecolumnright, mod_taskboard{{/str}}</button>
                    {{/canmoveright}}
                    <button type="button" class="dropdown-item text-danger" data-action="deletecolumn" data-columnid="{{id}}">{{#str}}deletecolumn, mod_taskboard{{/str}}</button>
                </div>
            </div>
            {{/canmanage}}
        </div>
    </div>
    <p class="mod_taskboard-wipwarning small mb-0" role="status">{{#str}}wipexceeded, mod_taskboard, {{wiplimit}}{{/str}}</p>
    <div class="mod_taskboard-cardlist" data-region="mod_taskboard-cardlist" data-columnid="{{id}}">
        {{#cards}}
            {{> mod_taskboard/card }}
        {{/cards}}
    </div>
    {{#canadd}}
    <button type="button" class="btn btn-link text-start mod_taskboard-addcard" data-action="addcard" data-columnid="{{id}}">
        {{#str}}addcard, mod_taskboard{{/str}}
    </button>
    {{/canadd}}
</section>
