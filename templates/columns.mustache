{{!
    @template mod_taskboard/columns

    All columns of a board; rendered on page load and again whenever the board changes.

    Example context (json):
    {
        "id": 7, "key": "g5", "istemplate": false, "timemodified": 0,
        "canmanagecolumns": true, "canadd": true,
        "columns": [
            {"id": 1, "title": "To do", "wiplimit": 0, "haswiplimit": false, "isdone": false, "count": 0,
             "overlimit": false, "countlabel": "0", "canmanage": true, "canmoveleft": false,
             "canmoveright": true, "canadd": true, "cards": []}
        ]
    }
}}
<div class="mod_taskboard-columns" data-region="mod_taskboard-board" data-timemodified="{{timemodified}}">
    {{#columns}}
        {{> mod_taskboard/column }}
    {{/columns}}
    {{#canmanagecolumns}}
    <div class="mod_taskboard-addcolumn">
        <button type="button" class="btn btn-outline-primary w-100" data-action="addcolumn">
            {{#str}}addcolumn, mod_taskboard{{/str}}
        </button>
    </div>
    {{/canmanagecolumns}}
</div>
